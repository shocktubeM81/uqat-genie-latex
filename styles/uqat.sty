% =========================================================
% 8. Dates et métadonnées
% =========================================================
\RequirePackage[useregional]{datetime2} % gestion intelligente des dates
\newcommand{\etablissement}{Université du Québec en Abitibi-Témiscamingue}
\newcommand{\departement}{École de génie}

\newcommand{\dateremise}{\DTMtoday} % par défaut = aujourd'hui
\newcommand{\session}{\textbf{(session non définie)}}
\newcommand{\setduedate}[4][]{%
	\DTMsavedate{duedate}{#2-#3-#4}%
	\renewcommand{\dateremise}{\DTMusedate{duedate}}%
	\def\override{#1}%
	\ifx\override\empty
		\begingroup
		\edef\MD{\number\numexpr #3*100 + #4\relax}% MMJJ
		\edef\YEAR{\number#2\relax}%
		\edef\PREVYEAR{\number\numexpr #2-1\relax}%
		% Seuils: 01/12 , 05/04 , 09/04
		\ifnum\MD<112
			\xdef\session{Automne~\PREVYEAR}%
		\else\ifnum\MD<504
				\xdef\session{Hiver~\YEAR}%
			\else\ifnum\MD<903
					\xdef\session{Été~\YEAR}%
				\else
					\xdef\session{Automne~\YEAR}%
				\fi\fi\fi
		\endgroup
	\else
		\xdef\session{#1}%
	\fi
}

% =========================================================
% 9. Bibliographie
% =========================================================
\RequirePackage[
	backend=biber,
	style=ieee,
	citestyle=numeric,
	sorting=nyt,
	defernumbers=true,
	language=french,
	autolang=other,
	backref=true
]{biblatex}                % bibliographie avec biber

\AtBeginBibliography{\footnotesize\singlespacing} % Taille du texte
\setlength{\bibitemsep}{0.6\baselineskip}         % Espacement
\DeclareNameAlias{default}{family-given}          % Nom de famille par défaut
\DeclareBibliographyAlias{legislation}{online}
\DeclareFieldFormat{url}{\url{#1}}                % Afficher l'URL, sans "Adresse :"

\DefineBibliographyStrings{french}{ % Paramètres de la langue
	bibliography = {Bibliographie},
	references   = {Références},
	in           = {dans},          % Pour article dans une publication
	backrefpage  = {cité à la p.},  % Pour backref
	backrefpages = {cité aux p.},
	volume       = {volume},
	volumes      = {volumes},
	jourvol      = {vol.},
}

\defbibheading{bibliography}[\refname]{% entete de bibliographie
	\clearpage
	\phantomsection
	\section*{#1}%
	\markboth{#1}{#1}%
	\addcontentsline{toc}{section}{#1}%
}

% Position du lieu dans la bibliographie

% Articles : lieu immédiatement après le nom de la revue
\renewbibmacro*{journal}{%
	\iffieldundef{journaltitle}
	{}
	{%
		\printtext[journaltitle]{%
			\printfield[titlecase]{journaltitle}%
			\setunit{\subtitlepunct}%
			\printfield[titlecase]{journalsubtitle}%
		}%
		\newunit
		\printlist{location}%
	}%
}

% Livres / ouvrages : maison d'édition, puis lieu, puis date
\renewbibmacro*{publisher+location+date}{%
	\printlist{publisher}%
	\newunit
	\printlist{location}%
	\newunit
	\usebibmacro{date}%
	\newunit
}

